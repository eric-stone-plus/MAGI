{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eric-stone-plus/MAGI/contracts/cross-review/1.1/schema.json",
  "title": "MAGI Anonymous Cross-review",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_version", "reviewer_alias", "subject_alias", "reviewer_profile_binding", "methodology_trace", "summary", "findings", "dissent"],
  "properties": {
    "review_version": {"const": "1.1"},
    "reviewer_alias": {"type": "string", "minLength": 1},
    "subject_alias": {"type": "string", "minLength": 1},
    "reviewer_profile_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_sha256", "profile_source_sha256", "thesis_sha256"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/digest"},
        "profile_source_sha256": {"$ref": "#/$defs/digest"},
        "thesis_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "methodology_trace": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/methodology"}
    },
    "summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "dissent": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "method", "application"],
      "properties": {
        "kind": {"enum": ["method", "failure_check"]},
        "method": {"type": "string", "minLength": 1},
        "application": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "type", "finding", "evidence_refs", "source_refs", "disposition", "required_closure", "closure_state", "closure_evidence", "scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "P0"]},
        "type": {"enum": ["contradiction", "omission", "evidence_gap", "confidence_mismatch", "drift", "execution_mismatch", "silent_collapse"]},
        "finding": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "disposition": {"enum": ["verified", "falsified", "unresolved", "escalated", "discarded"]},
        "required_closure": {"enum": ["none", "edit", "test", "command", "block", "waiver", "human_review"]},
        "closure_state": {"enum": ["open", "closed", "blocked", "waived", "not_applicable"]},
        "closure_evidence": {"type": "array", "items": {"type": "string"}},
        "scope": {"type": "string"}
      }
    }
  }
}
