{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eric-stone-plus/MAGI/contracts/assignment-plan/1.0/schema.json",
  "title": "MAGI Frozen Assignment Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignment_plan_version", "trial_id", "objective", "global_checks", "seats",
    "cross_review_obligations", "finale_condition", "limitations", "plan_binding_sha256"
  ],
  "properties": {
    "assignment_plan_version": {"const": "1.0"},
    "trial_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "global_checks": {"$ref": "#/$defs/nonempty_strings"},
    "seats": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/seat"}},
    "cross_review_obligations": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/review"}},
    "finale_condition": {"$ref": "#/$defs/finale"},
    "limitations": {"$ref": "#/$defs/nonempty_strings"},
    "plan_binding_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "nonempty_strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "carrier": {
      "type": "object", "additionalProperties": false,
      "required": ["carrier_id", "snapshot_media_classes", "multimodal_media_types", "allow_sampled_video"],
      "properties": {
        "carrier_id": {"type": "string", "minLength": 1},
        "snapshot_media_classes": {"$ref": "#/$defs/strings"},
        "multimodal_media_types": {"$ref": "#/$defs/strings"},
        "allow_sampled_video": {"type": "boolean"}
      }
    },
    "seat": {
      "type": "object", "additionalProperties": false,
      "required": [
        "seat_id", "family", "provider", "text_model", "multimodal_model", "profile_id",
        "profile_source_sha256", "container_service", "image_digest", "primary_focus",
        "mandatory_global_checks", "evidence_refs", "carrier_capabilities", "cost_rationale",
        "independence_class", "limitations"
      ],
      "properties": {
        "seat_id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "text_model": {"type": "string", "minLength": 1},
        "multimodal_model": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "profile_source_sha256": {"$ref": "#/$defs/digest"},
        "container_service": {"type": "string", "minLength": 1},
        "image_digest": {"$ref": "#/$defs/digest"},
        "primary_focus": {"$ref": "#/$defs/nonempty_strings"},
        "mandatory_global_checks": {"$ref": "#/$defs/nonempty_strings"},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "carrier_capabilities": {"$ref": "#/$defs/carrier"},
        "cost_rationale": {"type": "string", "minLength": 1},
        "independence_class": {"type": "string", "minLength": 1},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_seat_id", "subject_seat_id", "review_kind", "required_checks", "evidence_refs", "limitations"],
      "properties": {
        "reviewer_seat_id": {"type": "string", "minLength": 1},
        "subject_seat_id": {"type": "string", "minLength": 1},
        "review_kind": {"enum": ["artifact_review", "evidence_review", "author_consistency_review"]},
        "required_checks": {"$ref": "#/$defs/nonempty_strings"},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "finale": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_outcomes", "material_residual_states", "required_receipts", "stop_rule"],
      "properties": {
        "allowed_outcomes": {"$ref": "#/$defs/nonempty_strings"},
        "material_residual_states": {"$ref": "#/$defs/nonempty_strings"},
        "required_receipts": {"$ref": "#/$defs/nonempty_strings"},
        "stop_rule": {"type": "string", "minLength": 1}
      }
    }
  }
}
