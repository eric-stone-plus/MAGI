{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eric-stone-plus/MAGI/contracts/final-verdict/1.0/schema.json",
  "title": "MAGI Final Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict_version", "decision", "summary", "recommendation", "findings", "dissent"],
  "properties": {
    "verdict_version": {"const": "1.0"},
    "decision": {"enum": ["PASS", "BLOCK", "ESCALATE"]},
    "summary": {"type": "string", "minLength": 1},
    "recommendation": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "dissent": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "type", "finding", "evidence_refs", "source_refs", "disposition", "required_closure", "closure_state", "closure_evidence", "scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "P0"]},
        "type": {"enum": ["contradiction", "omission", "evidence_gap", "confidence_mismatch", "drift", "execution_mismatch", "silent_collapse"]},
        "finding": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "disposition": {"enum": ["verified", "falsified", "unresolved", "escalated", "discarded"]},
        "required_closure": {"enum": ["none", "edit", "test", "command", "block", "waiver", "human_review"]},
        "closure_state": {"enum": ["open", "closed", "blocked", "waived", "not_applicable"]},
        "closure_evidence": {"type": "array", "items": {"type": "string"}},
        "scope": {"type": "string"}
      }
    }
  }
}
