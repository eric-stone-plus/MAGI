{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eric-stone-plus/MAGI/contracts/profile/1.0/schema.json",
  "title": "Independent Review Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "profile_id", "discipline", "epistemic_lens", "methods", "failure_checks", "instructions"],
  "properties": {
    "profile_version": {"const": "1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "discipline": {"type": "string", "minLength": 1},
    "epistemic_lens": {"type": "string", "minLength": 1},
    "methods": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "failure_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "instructions": {"type": "string", "minLength": 1}
  }
}
