  "_seat": { "id": "seat-g", "family": "openai", "note": "GPT 中转席;计费 0.52x;模型身份未经 canary 核验前输出降级 advisory" },
  "policy_version": "2.0",
  "roster": [
    { "party_id": "Party A", "route_id": "codewhale", "adapter": "codewhale", "executable": "codewhale", "required": true, "family": "openai", "model": "gpt5.6-sol", "_note": "待验证:codewhale 自定义 provider/base_url;不可行则改 omp" },
    { "party_id": "Party B", "route_id": "opencode", "adapter": "opencode", "executable": "opencode", "required": true, "family": "openai", "model": "gpt5.6-sol", "_note": "高可行:opencode 支持自定义 provider" },
    { "party_id": "Party C", "route_id": "kilo", "adapter": "kilo", "executable": "kilo", "required": true, "family": "openai", "model": "gpt5.6-sol", "_note": "待验证;不可行则改 omp" },
    { "party_id": "Party D", "route_id": "omp_gpt", "adapter": "omp", "executable": "omp", "required": true, "family": "openai", "model": "gpt5.6-sol", "_note": "mimo CLI 仅 MiMo 后端;此 lane 改由 omp 承载(pi-ai 原生 OpenAI 协议)" },
    { "party_id": "Party E", "route_id": "omp", "adapter": "omp", "executable": "omp", "required": true, "family": "openai", "model": "gpt5.6-sol" }
